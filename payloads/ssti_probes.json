{
  "meta": {
    "description": "Benign arithmetic polyglot probes for Server-Side Template Injection (SSTI) detection. Each probe injects a template expression that evaluates a distinctive multiplication. Detection relies on the computed product appearing in the response (proving server-side evaluation), NOT on executing any destructive payload.",
    "usage": "Wrap each probe value into the target parameter. If the response contains the marked 'expected' string, the template engine evaluated the expression. If only the literal probe is reflected, it was NOT evaluated (not vulnerable).",
    "safe": true,
    "marker_prefix": "vtxSSTI",
    "marker_suffix": "ENDvtx",
    "references": [
      "https://portswigger.net/research/server-side-template-injection",
      "https://owasp.org/www-community/attacks/Server_Side_Template_Injection"
    ]
  },
  "probes": [
    {
      "id": "ssti_jinja_twig_curly",
      "engines": ["Jinja2", "Twig", "Nunjucks"],
      "value": "vtxSSTI{{191*7}}ENDvtx",
      "literal": "vtxSSTI{{191*7}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_freemarker_dollar",
      "engines": ["FreeMarker", "Thymeleaf-inline"],
      "value": "vtxSSTI${191*7}ENDvtx",
      "literal": "vtxSSTI${191*7}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_velocity_hash",
      "engines": ["Velocity", "Spring-EL hash"],
      "value": "vtxSSTI#{191*7}ENDvtx",
      "literal": "vtxSSTI#{191*7}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_smarty_single",
      "engines": ["Smarty", "Mako-brace"],
      "value": "vtxSSTI{191*7}ENDvtx",
      "literal": "vtxSSTI{191*7}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_erb_scriptlet",
      "engines": ["ERB", "EJS"],
      "value": "vtxSSTI<%= 191*7 %>ENDvtx",
      "literal": "vtxSSTI<%= 191*7 %>ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_razor_at",
      "engines": ["Razor"],
      "value": "vtxSSTI@(191*7)ENDvtx",
      "literal": "vtxSSTI@(191*7)ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_handlebars_helper",
      "engines": ["Handlebars", "Mustache"],
      "value": "vtxSSTI{{#with 1337}}{{this}}{{/with}}ENDvtx",
      "literal": "vtxSSTI{{#with 1337}}{{this}}{{/with}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Logic-less engines: Handlebars #with passes a literal to {{this}}, no arithmetic."
    },
    {
      "id": "ssti_handlebars_lookup",
      "engines": ["Handlebars"],
      "value": "vtxSSTI{{lookup (list 1337) 0}}ENDvtx",
      "literal": "vtxSSTI{{lookup (list 1337) 0}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Handlebars lookup helper: retrieves index 0 from a constructed list."
    },
    {
      "id": "ssti_pebble_curly",
      "engines": ["Pebble"],
      "value": "vtxSSTI{{ 191 * 7 }}ENDvtx",
      "literal": "vtxSSTI{{ 191 * 7 }}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Pebble Java engine uses Jinja-style {{ }} with spaces."
    }
  ],
  "header_probes": [
    {
      "id": "ssti_header_referer_jinja",
      "header": "Referer",
      "engines": ["Jinja2", "Twig", "Nunjucks"],
      "value": "vtxSSTI{{191*7}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Inject via Referer header — reflected by error/debug pages."
    },
    {
      "id": "ssti_header_referer_freemarker",
      "header": "Referer",
      "engines": ["FreeMarker"],
      "value": "vtxSSTI${191*7}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_header_ua_jinja",
      "header": "User-Agent",
      "engines": ["Jinja2", "Twig", "Nunjucks"],
      "value": "vtxSSTI{{191*7}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Inject via User-Agent — logged and sometimes rendered in dashboards."
    },
    {
      "id": "ssti_header_ua_freemarker",
      "header": "User-Agent",
      "engines": ["FreeMarker"],
      "value": "vtxSSTI${191*7}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx"
    },
    {
      "id": "ssti_header_xfwd_jinja",
      "header": "X-Forwarded-For",
      "engines": ["Jinja2", "Twig"],
      "value": "vtxSSTI{{191*7}}ENDvtx",
      "expected": "vtxSSTI1337ENDvtx",
      "note": "Inject via X-Forwarded-For — apps that log/display client IP."
    }
  ]
}
