{
  "meta": {
    "description": "Benign NoSQL injection probes for MongoDB / CouchDB / Firebase / generic document stores. Operator probes test query-logic bypass via parameter-operator injection (e.g. param[$ne]= or JSON body nested object); boundary probes elicit NoSQL parser/driver error messages. No destructive operators ($where with code, $out, dropDatabase, etc.) are ever sent.",
    "usage": "Operator probes replace the parameter KEY or nest into JSON bodies. Boundary probes append to the parameter VALUE and the response is matched against error patterns.",
    "safe": true,
    "references": [
      "https://owasp.org/www-community/attacks/NoSQL_injection",
      "https://portswigger.net/web-security/nosql-injection",
      "https://firebase.google.com/docs/database/security"
    ]
  },
  "boundary_probes": [
    { "id": "nosql_quote_brace", "value": "'\"{" },
    { "id": "nosql_close_object", "value": "\"})" },
    { "id": "nosql_backslash", "value": "'\\" }
  ],
  "operator_probes": [
    {
      "id": "nosql_ne_true",
      "operator": "$ne",
      "value": "vtxNoSQLvalueThatDoesNotExist",
      "logic": "true",
      "description": "$ne to a random value matches every document (always-true)."
    },
    {
      "id": "nosql_eq_false",
      "operator": "$eq",
      "value": "vtxNoSQLvalueThatDoesNotExist",
      "logic": "false",
      "description": "$eq to a random value matches no document (always-false)."
    }
  ],
  "json_operator_probes": [
    {
      "id": "nosql_json_ne",
      "operator": "$ne",
      "value": "vtxNoSQLvalueThatDoesNotExist",
      "logic": "true",
      "description": "JSON body nested $ne operator matches all documents (always-true)."
    },
    {
      "id": "nosql_json_eq",
      "operator": "$eq",
      "value": "vtxNoSQLvalueThatDoesNotExist",
      "logic": "false",
      "description": "JSON body nested $eq operator matches no documents (always-false)."
    }
  ],
  "nosql_error_patterns": {
    "patterns": {
      "MongoDB": [
        "MongoError",
        "MongoServerError",
        "MongoNetworkError",
        "E11000 duplicate key",
        "unknown operator",
        "FailedToParse",
        "BadValue",
        "\\$where",
        "CastError",
        "Cannot read propert(?:y|ies) of",
        "ObjectParameterError"
      ],
      "CouchDB": [
        "query_parse_error",
        "\"error\":\"(?:bad_request|query_parse_error)\"",
        "invalid UTF-8 JSON"
      ],
      "Firebase": [
        "FirebaseError",
        "PERMISSION_DENIED",
        "firebase(?:-admin|\\.database|\\.firestore)?",
        "7 PERMISSION_DENIED",
        "Missing or insufficient permissions",
        "INVALID_ARGUMENT",
        "Error: value for argument"
      ],
      "Generic": [
        "SyntaxError: Unexpected token",
        "JSON\\.parse",
        "unexpected end of (?:JSON|input)"
      ]
    }
  },
  "false_positive_filter": {
    "baseline_error_indicators": [
      "mongoerror",
      "query_parse_error",
      "casterror",
      "failedtoparse",
      "firebase",
      "permission_denied"
    ]
  }
}
